{
	"extends": "../tsconfig.json",
	"compilerOptions": {
		"rootDir": "../",
		"lib": ["es2022", "esnext", "dom"],
		"noImplicitReturns": false,
		"noUnusedLocals": false,
		"noEmit": true
	},
	"include": [
		"../src/**/*",
		"../devtools/src/**/*",
		"*",
		"browser/*",
		"fixtures/live-inspector/*",
		"../benchmarks/**/*.ts",
		"../playwright.inspector.config.mts",
		"../vite.config.mts",
		"../vitest.config.mts"
	],
	"exclude": ["node_modules"]
}
