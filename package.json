{
	"name": "r-state-tree",
	"version": "0.12.0",
	"description": "reactive state management library",
	"homepage": "https://github.com/melnikov-s/r-state-tree#readme",
	"bugs": {
		"url": "https://github.com/melnikov-s/r-state-tree/issues"
	},
	"license": "MIT",
	"author": "Sergey Melnikov",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/melnikov-s/r-state-tree.git"
	},
	"bin": {
		"r-state-tree-inspector": "./dist/devtools-mcp.cjs"
	},
	"files": [
		"dist",
		"docs/inspection.md",
		"THIRD_PARTY_NOTICES",
		"skills",
		"lint",
		"README.md",
		"LICENSE"
	],
	"main": "dist/r-state-tree.cjs",
	"module": "dist/r-state-tree.js",
	"types": "dist/src/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/src/index.d.ts",
			"import": "./dist/r-state-tree.js",
			"require": "./dist/r-state-tree.cjs"
		},
		"./lint": "./lint/index.mjs",
		"./devtools": {
			"types": "./dist/devtools/src/devtools.d.ts",
			"import": "./dist/devtools.js",
			"require": "./dist/devtools.cjs"
		},
		"./devtools/vite/client": {
			"types": "./dist/devtools/src/devtools-vite-client.d.ts"
		},
		"./devtools/vite": {
			"types": "./dist/devtools/src/devtools-vite.d.ts",
			"import": "./dist/devtools-vite.js",
			"require": "./dist/devtools-vite.cjs"
		},
		"./react": {
			"types": "./dist/src/react.d.ts",
			"import": "./dist/react.js",
			"require": "./dist/react.cjs"
		}
	},
	"scripts": {
		"test": "vitest run && pnpm run test:types",
		"test:watch": "vitest",
		"test:inspector:serve": "vite --configLoader runner --config tests/fixtures/live-inspector/vite.config.mts",
		"benchmark:activity": "esbuild benchmarks/inspection-activity.ts --bundle --platform=node --format=esm --external:esbuild --outfile=node_modules/.cache/inspection-activity.mjs && node node_modules/.cache/inspection-activity.mjs",
		"test:inspector:e2e": "pnpm build && playwright test --config playwright.inspector.config.mts",
		"test:cover": "vitest run --coverage",
		"test:types": "tsc --noEmit -p tests/tsconfig.json",
		"build": "vite build && pnpm run build:types",
		"build:types": "tsc --emitDeclarationOnly",
		"lint": "oxlint --type-aware src devtools/src tests benchmarks scripts && pnpm run lint:fixtures && pnpm run format:check",
		"lint:fixtures": "node scripts/lint-fixtures.mjs",
		"format": "oxfmt --write src devtools/src tests benchmarks scripts *.mts",
		"format:check": "oxfmt --check src devtools/src tests benchmarks scripts *.mts",
		"prepublishOnly": "pnpm run build"
	},
	"dependencies": {
		"@preact/signals-core": "^1.14.4"
	},
	"devDependencies": {
		"@modelcontextprotocol/sdk": "^1.32.2",
		"@playwright/test": "^1.64.1",
		"@preact/signals-react": "^3.12.0",
		"@tsmetadata/polyfill": "^1.1.3",
		"@types/node": "^26.6.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@types/ws": "^8.18.2",
		"@vitest/coverage-v8": "^5.0.3",
		"esbuild": "^0.28.2",
		"jsdom": "^30.1.2",
		"oxfmt": "^0.72.0",
		"oxlint": "^1.87.0",
		"oxlint-tsgolint": "^7.0.2004",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"tslib": "^2.8.1",
		"typescript": "7.0.2",
		"vite": "8.3.4",
		"vitest": "5.0.3",
		"ws": "^8.22.1"
	},
	"peerDependencies": {
		"@modelcontextprotocol/sdk": "^1.32.2",
		"@preact/signals-react": "^3.10.3",
		"react": "^18.2.0 || ^19.0.0",
		"ws": "^8.22.1"
	},
	"peerDependenciesMeta": {
		"@modelcontextprotocol/sdk": {
			"optional": true
		},
		"@preact/signals-react": {
			"optional": true
		},
		"react": {
			"optional": true
		},
		"ws": {
			"optional": true
		}
	}
}
